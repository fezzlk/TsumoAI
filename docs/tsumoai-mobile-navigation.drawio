ticalAlign=middle;fontSize=12;fontFamily=Helvetica;spacing=8;" vertex="1" parent="p3-r1"><mxGeometry x="1370" y="22" width="180" height="38" as="geometry" /></mxCell><mxCell id="p3-session" value="対局ホーム&lt;br&gt;局・本場・親を表示&lt;br&gt;&lt;b&gt;和了者選択＋座席図ボタン&lt;/b&gt;" style="fillColor=#E8F1FF;strokeColor=#3973C6;fontColor=#163A63;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;spacing=8;" vertex="1" parent="p3-r1"><mxGeometry x="70" y="115" width="500" height="106" as="geometry" /></mxCell><mxCell id="p3-scan" value="縦持ち自動スキャン" style="fillColor=#E8F5E9;strokeColor=#4F9A5A;fontColor=#214D28;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;spacing=8;" vertex="1" parent="p3-r1"><mxGeometry x="630" y="135" width="220" height="66" as="geometry" /></mxCell><mxCell id="p3-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="p3-r1" source="p3-session" target="p3-scan"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-split" value="" style="fillColor=#F4F5F7;strokeColor=#7A828E;fontColor=#343A40;ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="p3-r1"><mxGeometry x="731" y="250" width="18" height="18" as="geometry" /></mxCell><mxCell id="p3-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="p3-r1" source="p3-scan" target="p3-split"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-lane-rec" value="並行処理 A：端末内認識" style="fillColor=#E8F5E9;strokeColor=#4F9A5A;fontColor=#214D28;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;spacingTop=12;spacingLeft=14;opacity=35;" vertex="1" parent="p3-r1"><mxGeometry x="170" y="300" width="520" height="190" as="geometry" /></mxCell><mxCell id="p3-rec" value="位置検出・crop&lt;br&gt;→ TFLite牌識別" style="fillColor=#E8F5E9;strokeColor=#4F9A5A;fontColor=#214D28;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;spacing=8;" vertex="1" parent="p3-r1"><mxGeometry x="300" y="365" width="260" height="72" as="geometry" /></mxCell><mxCell id="p3-lane-cond" value="並行処理 B：条件入力" style="fillColor=#F2EAFE;strokeColor=#8658C7;fontColor=#43256F;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;spacingTop=12;spacingLeft=14;opacity=35;" vertex="1" parent="p3-r1"><mxGeometry x="910" y="300" width="520" height="190" as="geometry" /></mxCell><mxCell id="p3-cond" value="立直 → 表ドラ&lt;br&gt;→ 立直時だけ裏ドラ" style="fillColor=#F2EAFE;strokeColor=#8658C7;fontColor=#43256F;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;spacing=8;" vertex="1" parent="p3-r1"><mxGeometry x="1040" y="355" width="260" height="92" as="geometry" /></mxCell><mxCell id="p3-e4" value="認識" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;exitX=0;exitY=0.5;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="p3-r1" source="p3-split" target="p3-rec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="259" /><mxPoint x="650" y="275" /><mxPoint x="430" y="275" /></Array></mxGeometry></mxCell><mxCell id="p3-e5" value="条件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;exitX=1;exitY=0.5;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="p3-r1" source="p3-split" target="p3-cond"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="259" /><mxPoint x="900" y="275" /><mxPoint x="1170" y="275" /></Array></mxGeometry></mxCell><mxCell id="p3-join" value="認識と必須条件が&lt;br&gt;両方そろう" style="fillColor=#FFF4D6;strokeColor=#D89B24;fontColor=#6D4700;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;spacing=8;" vertex="1" parent="p3-r1"><mxGeometry x="650" y="555" width="300" height="85" as="geometry" /></mxCell><mxCell id="p3-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;exitX=0.5;exitY=1;entryX=0.25;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="p3-r1" source="p3-rec" target="p3-join"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="520" /><mxPoint x="725" y="520" /></Array></mxGeometry></mxCell><mxCell id="p3-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;exitX=0.5;exitY=1;entryX=0.75;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="p3-r1" source="p3-cond" target="p3-join"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="520" /><mxPoint x="875" y="520" /></Array></mxGeometry></mxCell><mxCell id="p3-result" value="結果画面&lt;br&gt;&lt;b&gt;ツモ／ロンを両方表示&lt;/b&gt;&lt;br&gt;枠・牌・枚数・和了牌・条件を訂正" style="fillColor=#E8F1FF;strokeColor=#3973C6;fontColor=#163A63;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;spacing=8;" vertex="1" parent="p3-r1"><mxGeometry x="610" y="690" width="380" height="115" as="geometry" /></mxCell><mxCell id="p3-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="p3-r1" source="p3-join" target="p3-result"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-next" value="「この結果で局終了」&lt;br&gt;局・親・本場を更新して対局ホームへ" style="fillColor=#E8F1FF;strokeColor=#3973C6;fontColor=#163A63;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;spacing=8;" vertex="1" parent="p3-r1"><mxGeometry x="1080" y="700" width="350" height="95" as="geometry" /></mxCell><mxCell id="p3-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="p3-r1" source="p3-result" target="p3-next"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3-note" value="ドラは次局でクリアする。南4局後は西1局へ進み、以後も「対局終了」が押されるまでE/S/W/Nを自動進行する。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="p3-r1"><mxGeometry x="280" y="860" width="1100" height="35" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="04_対局ホームの補助操作"><mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0"><root><mxCell id="p4-r0" /><mxCell id="p4-r1" parent="p4-r0" /><mxCell id="p4-t" value="対局ホームから行う補助操作" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=27;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="p4-r1"><mxGeometry x="40" y="18" width="1060" height="40" as="geometry" /></mxCell><mxCell id="p4-s" value="和了以外の操作を独立して示す。各処理の終点に「戻る／終了」を明記し、交差する戻り矢印を描かない。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="p4-r1"><mxGeometry x="40" y="66" width="1250" height="3