-r1"><mxGeometry x="630" y="470" width="300" height="115" as="geometry" /></mxCell><mxCell id="p2-er-wait" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;exitX=0.5;exitY=1;entryX=0.5633333333333334;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="p2-r1" source="p2-j" target="p2-wait"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p2-ai" value="&lt;b&gt;AI相談結果&lt;/b&gt;&lt;br&gt;決定的計算＋AI説明&lt;br&gt;卓況をチャットで追加" style="fillColor=#E8F1FF;strokeColor=#3973C6;fontColor=#163A63;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;spacing=8;" vertex="1" parent="p2-r1"><mxGeometry x="1120" y="470" width="300" height="115" as="geometry" /></mxCell><mxCell id="p2-er-ai" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#52606D;exitX=1;exitY=0.5;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="p2-r1" source="p2-j" target="p2-ai"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="369" /><mxPoint x="1050" y="430" /><mxPoint x="1270" y="430" /></Array></mxGeometry></mxCell><mxCell id="p2-lane-reuse" value="結果後の操作" style="fillColor=#FFF4D6;strokeColor=#D89B24;fontColor=#6D4700;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;spacingTop=12;spacingLeft=14;opacity=35;" vertex="1" parent="p2-r1"><mxGeometry x="140" y="680" width="1260" height="150" as="geometry" /></mxCell><mxCell id="p2-reuse" value="「別の確認」では&lt;br&gt;確定した画像・枠・牌を再利用" style="fillColor=#FFF4D6;strokeColor=#D89B24;fontColor=#6D4700;rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=16;fontFamily=Helvetica;spacing=8;" vertex="1" parent="p2-r1"><mxGeometry x="360" y="730" width="360" height="72" as="geometry" /></mxCell><mxCell id="p2-end" 