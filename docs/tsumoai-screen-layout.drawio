ne" value="東" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B78D0;strokeColor=#075A9C;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="layout-game-1"><mxGeometry x="557" y="435" width="100" height="60" as="geometry" /></mxCell><mxCell id="game-end" value="対局終了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="layout-game-1"><mxGeometry x="453" y="627" width="294" height="48" as="geometry" /></mxCell><mxCell id="game-score" value="点数計算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="layout-game-1"><mxGeometry x="453" y="511" width="143" height="44" as="geometry" /></mxCell><mxCell id="game-wait" value="待ち確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="layout-game-1"><mxGeometry x="604" y="511" width="143" height="44" as="geometry" /></mxCell><mxCell id="game-discard" value="何切る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="layout-game-1"><mxGeometry x="453" y="563" width="143" height="44" as="geometry" /></mxCell><mxCell id="game-call" value="鳴き判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="layout-game-1"><mxGeometry x="604" y="563" width="143" height="44" as="geometry" /></mxCell><mxCell id="game-progress-note" value="南4局の次は西1局へ自動進行&#10;終了したい時に「対局終了」" style="text;html=1;fontSize=10;fontColor=#627D98;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="layout-game-1"><mxGeometry x="453" y="685" width="294" height="42" as="geometry" /></mxCell><mxCell id="game-callout" value="座席名は東南西北&#10;起家の席へ「起家」表示&#10;現在の親へ「親」表示&#10;局情報・ドラ・戻す・流局は座席図の四隅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F9E5;strokeColor=#57AE5B;fontColor=#276749;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="layout-game-1"><mxGeometry x="805" y="285" width="300" height="112" as="geometry" /></mxCell><mxCell id="game-undo" value="1局戻す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="game-1"><mxGeometry x="453" y="443" width="82" height="46" as="geometry" /></mxCell><mxCell id="game-draw" value="流局" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="game-1"><mxGeometry x="665" y="443" width="82" height="46" as="geometry" /></mxCell><mxCell id="game-starting-badge" value="起家" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="game-1"><mxGeometry x="562" y="472" width="40" height="18" as="geometry" /></mxCell><mxCell id="game-dealer-badge" value="親" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#D9A514;fontColor=#7A5B00;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="game-1"><mxGeometry x="610" y="472" width="40" height="18" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="layout-draw" name="04b_モバイル_対局ホーム_流局ダイアログ"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="draw-dialog-0" /><mxCell id="draw-dialog-1" parent="draw-dialog-0" /><mxCell id="draw-dialog-title" value="04b モバイル：対局ホームの流局ダイアログ" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=24;fontStyle=1;align=left;fontColor=#102A43;" vertex="1" parent="draw-dialog-1"><mxGeometry x="40" y="24" width="1120" height="44" as="geometry" /></mxCell><mxCell id="draw-dialog-note" value="流局は独立画面へ遷移せず、対局ホーム上の確認ダイアログで親継続／親交代を選ぶ。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#7CA7D8;fontColor=#1F4E79;fontSize=13;align=left;spacing=10;" vertex="1" parent="draw-dialog-1"><mxGeometry x="40" y="74" width="1120" height="54" as="geometry" /></mxCell><mxCell id="draw-dialog-phone-shell-lane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334E68;strokeWidth=2;arcSize=8;" vertex="1" parent="draw-dialog-1"><mxGeometry x="435" y="145" width="330" height="620" as="geometry" /></mxCell><mxCell id="draw-dialog-phone-screen-lane" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#CBD5E1;" vertex="1" parent="draw-dialog-1"><mxGeometry x="445" y="161" width="310" height="588" as="geometry" /></mxCell><mxCell id="draw-dialog-status" value="9:41　　　　　　　　　　　　● ● ●" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=10;fontColor=#627D98;align=center;" vertex="1" parent="draw-dialog-1"><mxGeometry x="453" y="165" width="294" height="22" as="geometry" /></mxCell><mxCell id="draw-dialog-backdrop-lane" value="‹ ホーム　　　　　　　　　対局&#10;&#10;和了者を選択&#10;&#10;東1局　　西　　表ドラ&#10;&#10;北　　　卓　　　南&#10;&#10;1局戻す　東　　 流局&#10;&#10;点数計算　　　待ち確認&#10;何切る　　　　鳴き判断&#10;&#10;対局終了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B8794;strokeColor=#52606D;fontColor=#FFFFFF;fontSize=12;align=left;spacing=12;opacity=55;" vertex="1" parent="draw-dialog-1"><mxGeometry x="453" y="189" width="294" height="550" as="geometry" /></mxCell><mxCell id="draw-dialog-modal-lane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;strokeWidth=2;arcSize=10;" vertex="1" parent="draw-dialog-1"><mxGeometry x="463" y="300" width="274" height="270" as="geometry" /></mxCell><mxCell id="draw-dialog-modal-title" value="流局" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#102A43;align=left;" vertex="1" parent="draw-dialog-1"><mxGeometry x="477" y="314" width="210" height="34" as="geometry" /></mxCell><mxCell id="draw-dialog-close" value="×" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#627D98;align=center;" vertex="1" parent="draw-dialog-1"><mxGeometry x="701" y="314" width="24" height="34" as="geometry" /></mxCell><mxCell id="draw-dialog-question" value="親は継続しますか？" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#334E68;align=center;" vertex="1" parent="draw-dialog-1"><mxGeometry x="477" y="360" width="246" height="34" as="geometry" /></mxCell><mxCell id="draw-dialog-continue" value="親継続&#10;東1局 1本場へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B78D0;strokeColor=#075A9C;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;arcSize=10;" vertex="1" parent="draw-dialog-1"><mxGeometry x="477" y="408" width="246" height="68" as="geometry" /></mxCell><mxCell id="draw-dialog-rotate" value="親交代&#10;東2局 0本場へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=13;fontStyle=1;align=center;arcSize=10;" vertex="1" parent="draw-dialog-1"><mxGeometry x="477" y="488" width="246" height="68" as="geometry" /></mxCell><mxCell id="draw-dialog-callout" value="独立した画面遷移なし&#10;背景タップ・×は変更せず閉じる&#10;親継続／親交代は選択時に即時反映&#10;点棒・供託・聴牌人数は入力しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F9E5;strokeColor=#57AE5B;fontColor=#276749;fontSize=12;align=left;spacing=10;" vertex="1" parent="draw-dialog-1"><mxGeometry x="805" y="285" width="300" height="112" as="geometry" /></mxCe