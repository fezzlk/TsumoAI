334E68;strokeWidth=2;arcSize=8;" vertex="1" parent="call-detail-1"><mxGeometry x="425" y="145" width="350" height="850" as="geometry" /></mxCell><mxCell id="call-detail-phone-screen-lane" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#CBD5E1;" vertex="1" parent="call-detail-1"><mxGeometry x="435" y="161" width="330" height="818" as="geometry" /></mxCell><mxCell id="call-detail-status" value="9:41　　　　　　　　　　　　● ● ●" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=10;fontColor=#627D98;align=center;" vertex="1" parent="call-detail-1"><mxGeometry x="443" y="165" width="314" height="22" as="geometry" /></mxCell><mxCell id="call-detail-backdrop-lane" value="鳴き判断結果&#10;推奨　3萬・發&#10;条件付き　東・6筒&#10;見送り　2索・白" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B8794;strokeColor=#52606D;fontColor=#FFFFFF;fontSize=12;align=left;spacing=12;opacity=55;" vertex="1" parent="call-detail-1"><mxGeometry x="443" y="195" width="314" height="752" as="geometry" /></mxCell><mxCell id="call-detail-sheet-lane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;strokeWidth=2;arcSize=8;" vertex="1" parent="call-detail-1"><mxGeometry x="451" y="257" width="298" height="654" as="geometry" /></mxCell><mxCell id="call-detail-header" value="東をポン　　　　　　　　　閉じる" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#102A43;align=left;" vertex="1" parent="call-detail-1"><mxGeometry x="463" y="273" width="274" height="34" as="geometry" /></mxCell><mxCell id="call-detail-rating" value="条件付き" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#D9A514;fontColor=#7A5B00;fontSize=12;fontStyle=1;align=center;arcSize=20;" vertex="1" parent="call-detail-1"><mxGeometry x="463" y="313" width="86" height="32" as="geometry" /></mxCell><mxCell id="call-detail-shape-label" value="鳴き方" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#334E68;a