<mxfile host="app.diagrams.net" modified="2026-09-21T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="layout-home" name="01_モバイル_ホーム"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="layout-home-0" /><mxCell id="layout-home-1" parent="layout-home-0" /><mxCell id="home-title" value="01 モバイル：一般ホーム" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#102A43;" vertex="1" parent="layout-home-1"><mxGeometry x="40" y="24" width="1120" height="44" as="geometry" /></mxCell><mxCell id="home-note" value="目的選択を最優先。全操作48dp以上。対局中は同じカードを再開表示へ切り替え、アカウント操作は最下部へ置く。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#7CA7D8;fontColor=#1F4E79;fontSize=13;align=left;spacing=10;" vertex="1" parent="layout-home-1"><mxGeometry x="40" y="74" width="1120" height="54" as="geometry" /></mxCell><mxCell id="home-phone-shell-lane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334E68;strokeWidth=2;arcSize=8;" vertex="1" parent="layout-home-1"><mxGeometry x="435" y="145" width="330" height="604" as="geometry" /></mxCell><mxCell id="home-phone-screen-lane" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="layout-home-1"><mxGeometry x="445" y="161" width="310" height="572" as="geometry" /></mxCell><mxCell id="home-phone-status" value="9:41　　　　　　　　　　　　● ● ●" style="text;html=1;fontSize=10;fontColor=#627D98;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="layout-home-1"><mxGeometry x="453" y="165" width="294" height="22" as="geometry" /></mxCell><mxCell id="home-phone-header-lane" value="TsumoAI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#F8FAFC;fontSize=15;fontStyle=1;fontColor=#102A43;align=left;spacingLeft=12;" vertex="1" paren