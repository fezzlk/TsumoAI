=middle;arcSize=5;" vertex="1" parent="discard-result-1"><mxGeometry x="428" y="441" width="46" height="46" as="geometry" /></mxCell><mxCell id="discard-scroll" value="最大18枚を折り返して全表示（横スクロールなし）" style="text;html=1;fontSize=10;fontColor=#627D98;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="discard-result-1"><mxGeometry x="168" y="597" width="314" height="20" as="geometry" /></mxCell><mxCell id="discard-other" value="同じ牌で別の確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B78D0;strokeColor=#075A9C;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="discard-result-1"><mxGeometry x="168" y="1063" width="314" height="38" as="geometry" /></mxCell><mxCell id="discard-send" value="訂正内容を学習データとして送信&#10;※開発者設定ON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BCCCDC;fontSize=10;fontColor=#243B53;align=left;verticalAlign=middle;spacing=10;arcSize=8;" vertex="1" parent="discard-result-1"><mxGeometry x="168" y="1109" width="314" height="40" as="geometry" /></mxCell><mxCell id="discard-callout" value="判断基準に沿った上位3候補だけを表示&#10;初期値：牌効率重視&#10;他家リーチ・点数状況は初期計算に含めない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F9E5;strokeColor=#57AE5B;fontColor=#276749;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="discard-result-1"><mxGeometry x="560" y="245" width="260" height="92" as="geometry" /></mxCell><mxCell id="discard-callout2" value="判断基準&#10;・牌効率重視&#10;・打点優先&#10;・即和了優先&#10;・守備考慮（追加状況が必要）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#7CA7D8;fontColor=#1F4E79;fontSize=13;align=left;spacing=10;" vertex="1" parent="discard-result-1"><mxGeometry x="560" y="365" width="260" height="92" as="geometry" /></mxCell><mxCell id="discard-callout3" value="各候補に順位・向聴数・受け入れ・理由を表示&#10;詳細な場況は共通AIチャットへ&#10;枠の追加・削除機能は置かない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D69E2E;fontColor=#744210;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="discard-result-1"><mxGeometry x="560" y="485" width="260" height="92" as="geometry" /></mxCell><mxCell id="discard-tile-6" value="七萬" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#9FB3C8;fontSize=15;fontStyle=1;fontColor=#102A43;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="discard-result-1"><mxGeometry x="168" y="493" width="46" height="46" as="geometry" /></mxCell><mxCell id="discard-tile-7" value="八萬" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#9FB3C8;fontSize=15;fontStyle=1;fontColor=#102A43;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="discard-result-1"><mxGeometry x="220" y="493" width="46" height="46" as="geometry" /></mxCell><mxCell id="discard-tile-8" value="九萬" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#9FB3C8;fontSize=15;fontStyle=1;fontColor=#102A43;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="discard-result-1"><mxGeometry x="272" y="493" width="46" height="46" as="geometry" /></mxCell><mxCell id="discard-tile-9" value="一筒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#9FB3C8;fontSize=15;fontStyle=1;fontColor=#102A43;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="discard-result-1"><mxGeometry x="324" y="493" width="46" height="46" as="geometry" /></mxCell><mxCell id="discard-tile-10" value="二筒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#9FB3C8;fontSize=15;fontStyle=1;fontColor=#102A43;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="discard-result-1"><mxGeometry x="376" y="493" width="46" height="46" as="geometry" /></mxCell><mxCell id="discard-tile-11" value="三筒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#9FB3C8;fontSize=15;fontStyle=1;fontColor=#102A43;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="discard-result-1"><mxGeometry x="428" y="493" width="46" height="46" as="geometry" /></mxCell><mxCell id="discard-tile-12" value="四筒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#9FB3C8;fontSize=15;fontStyle=1;fontColor=#102A43;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="discard-result-1"><mxGeometry x="168" y="545" width="46" height="46" as="geometry" /></mxCell><mxCell id="discard-tile-13" value="五筒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF7;strokeColor=#9FB3C8;fontSize=15;fontStyle=1;fontColor=#102A43;align=center;verticalAlign=middle;arcSize=5;" vertex="1" parent="discard-result-1"><mxGeometry x="220" y="545" width="46" height="46" as="geometry" /></mxCell><mxCell id="discard-best" value="1位　5索&#10;1向聴を維持 / 受け入れ28枚&#10;牌効率を最も維持" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F9E5;strokeColor=#57AE5B;fontColor=#276749;fontSize=13;align=left;verticalAlign=middle;spacing=10;arcSize=10;" vertex="1" parent="discard-result-1"><mxGeometry x="168" y="695" width="314" height="70" as="geometry" /></mxCell><mxCell id="discard-alternatives" value="2位　東&#10;1向聴を維持 / 受け入れ24枚&#10;打点変化なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB3C8;fontColor=#334E68;fontSize=12;align=left;verticalAlign=middle;spacing=10;arcSize=10;" vertex="1" parent="discard-result-1"><mxGeometry x="168" y="775" width="314" height="70" as="geometry" /></mxCell><mxCell id="discard-reason" value="3位　9萬&#10;1向聴を維持 / 受け入れ20枚&#10;変化牌の種類が少ない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB3C8;fontColor=#334E68;fontSize=12;align=left;verticalAlign=middle;spacing=10;arcSize=10;" vertex="1" parent="discard-result-1"><mxGeometry x="168" y="855" width="314" height="70" as="geometry" /></mxCell><mxCell id="discard-chat" value="AIに相談&#10;テンプレートから選択 / 自由入力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=12;align=left;verticalAlign=middle;spacing=10;arcSize=10;" vertex="1" parent="discard-result-1"><mxGeometry x="168" y="935" width="314" height="58" as="geometry" /></mxCell><mxCell id="discard-chat-note" value="守備考慮など場況が必要な判断では&#10;不足情報をテンプレートまたは自由入力で追加" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D69E2E;fontColor=#744210;fontSize=11;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="discard-result-1"><mxGeometry x="168" y="1003" width="314" height="50" as="geometry" /></mxCell><mxCell id="discard-strategy" value="判断基準　牌効率重視　　変更&#10;他家リーチ・点数状況は考慮しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=11;align=left;verticalAlign=middle;spacing=10;arcSize=10;" vertex="1" parent="discard-result-1"><mxGeometry x="168" y="625" width="314" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="layout-ai-chat-sheet" name="03d_モバイル_AIチャット"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000" math="0" shadow="0"><root><mxCell id="ai-chat-0" /><mxCell id="ai-chat-1" parent="ai-chat-0" /><mxCell id="ai-chat-title" value="03d モバイル：AIチャット" style="text;html=1;fontColor=#102A43;whiteSpace=wrap;verticalAlign=middle;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="ai-chat-1"><mxGeometry x="40" y="24" width="1120" height="44" as="geometry" /></mxCell><mxCell id="ai-chat-note" value="結果画面から下からせり上がる大きなモーダルとして表示。状況テンプレートと質問の型を組み合わせ、自由編集して送信する。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#7CA7D8;fontColor=#1F4E79;fontSize=13;align=left;spacing=10;" vertex="1" parent="ai-chat-1"><mxGeometry x="40" y="74" width="1120" height="54" as="geometry" /></mxCell><mxCell id="ai-chat-phone-shell-lane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334E68;strokeWidth=2;arcSize=8;" vertex="1" parent="ai-chat-1"><mxGeometry x="425" y="145" width="350" height="810" as="geometry" /></mxCell><mxCell id="ai-chat-phone-screen-lane" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#CBD5E1;" vertex="1" parent="ai-chat-1"><mxGeometry x="435" y="161" width="330" height="778" as="geometry" /></mxCell><mxCell id="ai-chat-status" value="9:41　　　　　　　　　　　　　● ● ●" style="text;html=1;fontSize=10;fontColor=#627D98;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="ai-chat-1"><mxGeometry x="443" y="165" width="314" height="22" as="geometry" /></mxCell><mxCell id="ai-chat-backdrop" value="何切る結果：おすすめ5索&#10;背景の結果は保持して暗く表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9FB3C8;strokeColor=#7B8794;fontColor=#FFFFFF;fontSize=10;align=center;verticalAlign=middle;opacity=55;" vertex="1" parent="ai-chat-1"><mxGeometry x="443" y="195" width="314" height="54" as="geometry" /></mxCell><mxCell id="ai-chat-sheet-lane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;strokeWidth=2;arcSize=8;" vertex="1" parent="ai-chat-1"><mxGeometry x="443" y="255" width="314" height="674" as="geometry" /></mxCell><mxCell id="ai-chat-handle" value="━━━━" style="text;html=1;fontSize=14;fontColor=#9FB3C8;align=center;verticalAlign=middle;" vertex="1" parent="ai-chat-1"><mxGeometry x="533" y="263" width="134" height="18" as="geometry" /></mxCell><mxCell id="ai-chat-header" value="何切るをAIに相談　　　　　　　　　閉じる" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#102A43;align=left;verticalAlign=middle;" vertex="1" parent="ai-chat-1"><mxGeometry x="455" y="287" width="290" height="34" as="geometry" /></mxCell><mxCell id="ai-chat-context" value="自動添付&#10;認識牌14枚 / おすすめ5索&#10;1向聴 / 受け入れ28枚&#10;対局中は局・親子・表ドラも添付" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F9E5;strokeColor=#57AE5B;fontColor=#276749;fontSize=11;align=left;verticalAlign=middle;spacing=8;arcSize=10;" vertex="1" parent="ai-chat-1"><mxGeometry x="455" y="329" width="290" height="66" as="geometry" /></mxCell><mxCell id="ai-chat-thread" value="AI&#10;計算上は5索切りが第一候補です。&#10;追加の場況があれば選んでください。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#BCCCDC;fontColor=#334E68;fontSize=11;align=left;verticalAlign=middle;spacing=8;arcSize=10;" vertex="1" parent="ai-chat-1"><mxGeometry x="455" y="405" width="270" height="62" as="geometry" /></mxCell><mxCell id="ai-chat-situation-label" value="状況を選択（複数可）" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#334E68;align=left;verticalAlign=middle;" vertex="1" parent="ai-chat-1"><mxGeometry x="455" y="477" width="290" height="24" as="geometry" /></mxCell><mxCell id="ai-chat-sit-1" value="親リーチ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="ai-chat-1"><mxGeometry x="455" y="507" width="88" height="34" as="geometry" /></mxCell><mxCell id="ai-chat-sit-2" value="オーラス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=10;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="ai-chat-1"><mxGeometry x="549" y="507" width="88" height="34" as="geometry" /></mxCell><mxCell id="ai-chat-sit-3" value="トップ目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=10;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="ai-chat-1"><mxGeometry x="643" y="507" width="88" height="34" as="geometry" /></mxCell><mxCell id="ai-chat-sit-4" value="ラス目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=10;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="ai-chat-1"><mxGeometry x="455" y="547" width="88" height="34" as="geometry" /></mxCell><mxCell id="ai-chat-sit-5" value="守備優先" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=10;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="ai-chat-1"><mxGeometry x="549" y="547" width="88" height="34" as="geometry" /></mxCell><mxCell id="ai-chat-sit-6" value="ドラを残す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=10;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="ai-chat-1"><mxGeometry x="643" y="547" width="88" height="34" as="geometry" /></mxCell><mxCell id="ai-chat-question-label" value="質問の型" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#334E68;align=left;verticalAlign=middle;" vertex="1" parent="ai-chat-1"><mxGeometry x="455" y="631" width="290" height="24" as="geometry" /></mxCell><mxCell id="ai-chat-q-1" value="何を切る？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="ai-chat-1"><mxGeometry x="455" y="661" width="88" height="34" as="geometry" /></mxCell><mxCell id="ai-chat-q-2" value="押す？降りる？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=10;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="ai-chat-1"><mxGeometry x="549" y="661" width="88" height="34" as="geometry" /></mxCell><mxCell id="ai-chat-q-3" value="理由を詳しく" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=10;align=center;verticalAlign=middle;arcSize=20;" vertex="1" parent="ai-chat-1"><mxGeometry x="643" y="661" width="88" height="34" as="geometry" /></mxCell><mxCell id="ai-chat-compose" value="生成した質問（自由に編集できます）&#10;親リーチ中なら何を切るべきですか？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB3C8;fontColor=#334E68;fontSize=11;align=left;verticalAlign=middle;spacing=8;arcSize=10;" vertex="1" parent="ai-chat-1"><mxGeometry x="455" y="705" width="290" height="66" as="geometry" /></mxCell><mxCell id="ai-chat-send" value="送信" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B78D0;