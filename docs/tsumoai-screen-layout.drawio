;whiteSpace=wrap;html=1;fillColor=#FDE8E7;strokeColor=#D64545;fontColor=#8A1C1C;fontSize=11;align=left;spacing=8;arcSize=8;" vertex="1" parent="call-detail-1"><mxGeometry x="463" y="661" width="274" height="58" as="geometry" /></mxCell><mxCell id="call-detail-ai" value="この候補をAIに相談" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B78D0;strokeColor=#075A9C;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;arcSize=10;" vertex="1" parent="call-detail-1"><mxGeometry x="463" y="731" width="274" height="46" as="geometry" /></mxCell><mxCell id="call-detail-close" value="閉じる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B78D0;fontColor=#075A9C;fontSize=13;fontStyle=1;align=center;arcSize=10;" vertex="1" parent="call-detail-1"><mxGeometry x="463" y="787" width="274" height="40" as="geometry" /></mxCell><mxCell id="call-detail-callout-1" value="候補一覧の中央にモーダル表示&#10;背景タップまたは「閉じる」で戻る&#10;下スワイプ操作には依存しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#7CA7D8;fontColor=#1F4E79;fontSize=13;align=left;spacing=10;" vertex="1" parent="call-detail-1"><mxGeometry x="820" y="255" width="300" height="112" as="geometry" /></mxCell><mxCell id="call-detail-callout-2" value="共通表示&#10;・可能なチー／ポン／カンの形&#10;・向聴数と受け入れの変化&#10;・狙える役、推奨打牌、注意点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F9E5;strokeColor=#57AE5B;fontColor=#276749;fontSize=13;align=left;spacing=10;" vertex="1" parent="call-detail-1"><mxGeometry x="820" y="395" width="300" height="112" as="geometry" /></mxCell><mxCell id="call-detail-callout-3" value="内容が長い場合は&#10;モーダル内だけを縦スクロールする。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D9A514;fontColor=#6B4F00;fontSize=13;align=left;spacing=10;" vertex="1" parent="call-detail-1"><mxGeometry x="820" y="535" width="300" height="72" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="layout-game" name="04_モバイル_対局ホーム"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips