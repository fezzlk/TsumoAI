        <mxCell id="title" value="TsumoAI — 画像観測・意味解釈・機能実行の境界" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="撮影画像の曖昧な情報をユーザー確認で確定し、明示的に選択された解析機能へ渡す" style="text;html=1;align=left;fontSize=13;fontColor=#4d4d4d" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1000" height="25" as="geometry"/></mxCell>
