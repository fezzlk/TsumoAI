        <mxCell id="legend_partial" value="一部実装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="1430" y="30" width="115" height="35" as="geometry"/></mxCell>
        <mxCell id="legend_proposed" value="提案 / 未実装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1" vertex="1" parent="1"><mxGeometry x="1560" y="30" width="145" height="35" as="geometry"/></mxCell>

        <mxCell id="mobile" value="モバイル / ユーザー操作" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="800" as="geometry"/></mxCell>
        <mxCell id="feature_selection" value="機能を明示選択［実装済み］&#xa;score / tenpai / discard_analysis&#xa;※ 牌枚数では切り替えない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="mobile"><mxGeometry x="35" y="65" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="capture" value="撮影 UI［実装済み］&#xa;手持ち撮影 / ガイド表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf" vertex="1" parent="mobile"><mxGeometry x="35" y="205" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="image_recognition" value="画像加工・牌認識［実装済み］&#xa;補正 / 分割 / 分類" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf" vertex="1" parent="mobile"><mxGeometry x="35" y="320" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="confirmation_ui" value="推定結果の確認・修正 UI［実装済み］&#xa;牌 / 鳴き / あがり牌を明示確定&#xa;inferred・unknown は自動確定しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="mobile"><mxGeometry x="35" y="570" width="260" height="105" as="geometry"/></mxCell>

        <mxCell id="application" value="バックエンド API / アプリケーション層" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="410" y="110" width="740" height="800" as="geometry"/></mxCell>
        <mxCell id="recognition_api" value="Recognition API［実装済み］&#xa;認識結果と bbox を保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366" vertex="1" parent="application"><mxGeometry x="35" y="205" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="visual_observation" value="ObservationV1［実装済み］&#xa;候補牌 / confidence / bbox / 角度 / visual group&#xa;画像由来の観測だけを保持" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1" vertex="1" parent="application"><mxGeometry x="305" y="190" width="380" height="105" as="geometry"/></mxCell>
        <mxCell id="interpretation" value="Interpretation［実装済み］&#xa;POST /api/v1/interpretations&#xa;鳴き・あがり牌を confirmed / inferred / unknown で返す&#xa;inferred・unknown は要ユーザー確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1" vertex="1" parent="application"><mxGeometry x="305" y="350" width="380" height="115" as="geometry"/></mxCell>
        <mxCell id="confirmed_hand_state" value="POST /api/v1/confirmed-hands［実装済み］&#xa;ObservationV1 + ConfirmationV1&#xa;→ ConfirmedHandStateV1（確定した麻雀事実のみ）&#xa;あがり牌はユーザー指定。配列末尾から推測しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1" vertex="1" parent="application"><mxGeometry x="305" y="555" width="380" height="120" as="geometry"/></mxCell>
        <mxCell id="operation_routing" value="ConfirmedHandStateV1 の operation を実行［実装済み］&#xa;ユーザーが明示選択した score / tenpai / discard_analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1" vertex="1" parent="application"><mxGeometry x="35" y="700" width="650" height="60" as="geometry"/></mxCell>

        <mxCell id="domain" value="解析機能バックエンド（実装済み）" style="swimlane;html=1;rounded=1;startSize=36;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1190" y="110" width="570" height="800" as="geometry"/></mxCell>
        <mxCell id="score_api" value="API 境界（app/main.py）&#xa;POST /api/v1/score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="domain"><mxGeometry x="30" y="120" width="160" height="70" as="geometry"/></mxCell>
